# Configurações do Provedor de LLM
GEMINI_API_KEY=sua_chave_aqui
LLM_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
# Tempo máximo de espera por resposta da API, em segundos
LLM_TIMEOUT_SECONDS=60

# Configurações de Armazenamento e Cache
CACHE_DIR=storage/cache
STORAGE_DIR=storage
PROFILES_DIR=profiles
PROMPTS_DIR=prompts

# Flags Operacionais
ENABLE_CACHE=true
MOCK_MODE=false
